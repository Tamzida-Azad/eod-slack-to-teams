# Copy to .env and fill in your workspace values (never commit .env).

EOD_SLACK_WORKSPACE_URL=https://your-workspace.slack.com/
EOD_SLACK_TEAM_ID=T0000000000
EOD_SLACK_CHANNEL_NAME=eod-updates
EOD_SLACK_CHANNEL_ID=C0000000000

EOD_TEAMS_URL=https://teams.live.com/v2/
EOD_TEAMS_CHANNEL_NAME=Your Teams Channel Name

# Playwright persistent profile (create via your save-auth flow or point at an existing profile)
# EOD_BROWSER_PROFILE_DIR=./browser-profile
