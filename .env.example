# Public URL (OAuth redirect base). On Vercel this is usually auto-detected.
# APP_BASE_URL=https://eod-slack-to-teams.vercel.app

# Optional encryption mirror (secrets/tokens.enc + KV). Tokens are also written to this .env after OAuth.
# TOKEN_ENCRYPTION_KEY=replace-with-long-random-secret

# Slack user OAuth client (app is OAuth client only)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/oauth/slack/callback
SLACK_EOD_CHANNEL_ID=C0BES5FDJV8
# SLACK_USER_SCOPES=channels:history,channels:read,users:read,identify

# Slack user tokens — auto-filled after /integrations/slack Connect
SLACK_USER_ACCESS_TOKEN=
SLACK_USER_REFRESH_TOKEN=
SLACK_USER_ID=
SLACK_USER_LABEL=
SLACK_TEAM_ID=
SLACK_TEAM_LABEL=
SLACK_TOKEN_EXPIRES_AT=
SLACK_TOKEN_STATUS=
SLACK_TOKEN_SCOPE=
SLACK_TOKEN_ERROR=

# Microsoft / Teams user OAuth client
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
TEAMS_REDIRECT_URI=http://localhost:3000/api/oauth/teams/callback
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
# TEAMS_OAUTH_SCOPES=offline_access User.Read ChannelMessage.Send Channel.ReadBasic.All

# Teams user tokens — auto-filled after /integrations/teams Connect
TEAMS_USER_ACCESS_TOKEN=
TEAMS_USER_REFRESH_TOKEN=
TEAMS_USER_ID=
TEAMS_USER_LABEL=
TEAMS_TOKEN_EXPIRES_AT=
TEAMS_TOKEN_STATUS=
TEAMS_TOKEN_SCOPE=
TEAMS_TOKEN_ERROR=

# Protect /api/run-daily and disconnect
CRON_SECRET=change-me-cron
RUN_SECRET=change-me-run

# Optional
# EOD_DRY_RUN=1
# EOD_FORCE_TODAY=1
# EOD_MAX_ATTEMPTS=10
# EOD_LOOKBACK_DAYS=7
# STATE_BACKEND=file

# Vercel KV / Upstash (mirrors encrypted oauth tokens + eod state)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
